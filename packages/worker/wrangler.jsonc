{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iptv-studio",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/sub/*", "/epg/*", "/relay/*", "/shots/*"]
  },
  "routes": [
    {
      "pattern": "iptv.xu05236.dpdns.org/*",
      "zone_name": "xu05236.dpdns.org"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iptv-studio",
      "database_id": "da4e65ee-de99-455e-88ed-eb06d10cd139",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "d4fc0301922746df8af08e288172c1c4"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *", "17 */6 * * *"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_BASE_URL": "https://iptv.xu05236.dpdns.org",
    "GITHUB_REPO": "xu05236/iptv-studio",
    "GITHUB_WORKFLOW": "collect.yml",
    "GITHUB_REF": "main"
  }
}
