# GitHub Actions secrets for the collector.
# Artifacts are uploaded through the Worker admin API, so only two are required.
# Local runs: copy to .env and use `node --env-file=.env node_modules/.bin/tsx ...`

API_BASE_URL=https://iptv.example.com
ADMIN_TOKEN=change-me-please
PUBLIC_BASE_URL=https://iptv.example.com

# optional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PROBE_BUDGET=6000
PROBE_CONCURRENCY=48
SHOT_LIMIT=60
TRIGGER=manual
